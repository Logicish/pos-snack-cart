.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# 2026-08-28 — repo scope narrowed to source only, per explicit direction: "i just want
# the source saved. since that will be the longest to rebuild if something happened to it."
# (.gitignore comments must be on their own line -- a trailing "pattern # comment" is
# read as one literal, unmatchable pattern, not a pattern plus a comment.)

# Device/build photos -- for the public website (BUILD.md), not the repo.
pics/

# BUILD.md/CLAUDE.md/MIGRATION.md/snack_cart_pos.md -- narrative/status docs, not source.
*.md

# Copyrighted manufacturer PDFs (GM65/DFR0660 manuals) + their text extracts.
temp_resources/

# Dead backup files from the pre-SQLite LittleFS architecture -- superseded, not
# compiled, not current source.
*.bak

# Personal Claude Code settings (permission rules) -- not project source
.claude/settings.local.json

# Real SD-card DB snapshots -- contain real names/badges/Venmo handle, never commit
db_backups/
*.db
*.db-journal

# tools/tilt_lab.py working files -- the 2500-board pool is regenerable (gen/regrade);
# the shipped boards live in tools/slidefree/ and ARE committed
tools/puzzles*.json
__pycache__/

# Shelved CYOA engine + Hospital Town Games outline -- pulled from the launch build
# 2026-10-02, kept locally for post-launch work
cyoa_shelved/
